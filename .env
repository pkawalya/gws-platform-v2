# ── Database Configuration ──
# The app reads DB config from 3 sources in priority order:
#   1. db-config.json (set via the Settings > Database UI)
#   2. DATABASE_URL env var (this file or your hosting platform)
#   3. Default fallback (Prisma Postgres host)
#
# Uncomment and fill ONE of the formats below:

# Standard PostgreSQL URL:
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# With SSL:
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name?sslmode=require

# Prisma Postgres:
# DATABASE_URL=postgresql://API_KEY:API_PASSWORD@pooled.db.prisma.io:5432/postgres

# Neon Serverless:
# DATABASE_URL=postgresql://username:password@ep-xxx.region.aws.neon.tech/database?sslmode=require

# Supabase:
# DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres

# Local Development:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gws_platform

# Default (replace with your own credentials):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
